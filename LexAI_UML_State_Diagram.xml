        </mxCell>
        <mxCell id="legend" value="LECTURE UML&#10;&#10;Rectangle arrondi : état.&#10;Losange : choix ou fusion de chemins alternatifs.&#10;Disque : début. Double cercle : fin.&#10;&#10;événement [condition] / effet&#10;entry / action à l’entrée&#10;do / activité pendant l’état&#10;&#10;Les trois modules sont des alternatives pour une demande." style="shape=note;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=14;align=left;spacing=15;size=20;" vertex="1" parent="1">
