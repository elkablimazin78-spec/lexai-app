        </mxCell>
        <mxCell id="results" value="LIVRABLE SELON LE MODULE&#10;&#10;Veille : diagnostic d’impact et alerte sur les risques.&#10;&#10;Audit : analyse des clauses contractuelles à risque.&#10;&#10;Fiscal : ébauche de note de synthèse avec citations juridiques." style="shape=note;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=14;align=left;spacing=15;size=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1110" y="970" width="440" height="280" />
        </mxCell>
        <mxCell id="constraints" value="CONTRAINTES TRANSVERSALES&#10;&#10;• Cloisonnement strict des données clients.&#10;• Infrastructure cloud privée et souveraine.&#10;• Indexation et vectorisation sécurisées en amont.&#10;• Génération fondée sur les sources extraites.&#10;• Validation humaine systématique avant livraison.&#10;&#10;Les contraintes décrivent la conception annoncée dans le PDF, pas une conformité vérifiée." style="shape=note;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=14;align=left;spacing=15;size=20;" vertex="1" parent="1">
